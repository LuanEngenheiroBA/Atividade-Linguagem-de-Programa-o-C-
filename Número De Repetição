#include <stdio.h>

int main() {
    float numero;
    int i;

    printf("--- Algoritmo ECO (5 números) ---\n");

    for (i = 1; i <= 5; i++) {
        printf("Digite o número %d: ", i);
        // Lê o número
        if (scanf("%f", &numero) != 1) {
            printf("Entrada inválida!\n");
            return 1;
        }
        // Imprime imediatamente (efeito ECO)
        printf("ECO: %.2f\n\n", numero);
    }

    printf("Fim do algoritmo.\n");
    return 0;
}
