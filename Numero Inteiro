#include <stdio.h>

int main() {
    float numero;
    int i, positivos = 0;

    printf("--- Contador de Números Positivos ---\n");
    printf("Digite 5 números:\n");

    for (i = 1; i <= 5; i++) {
        printf("Número %d: ", i);
        if (scanf("%f", &numero) != 1) {
            printf("Entrada inválida!\n");
            return 1;
        }
        
        // Verifica se o número é positivo (maior que zero)
        if (numero > 0) {
            positivos++;
        }
    }

    printf("\n---------------------------------------\n");
    printf("Quantidade de números positivos: %d\n", positivos);
    printf("---------------------------------------\n");

    return 0;
}
