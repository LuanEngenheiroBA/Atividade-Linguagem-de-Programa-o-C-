#include <stdio.h>

int main() {
    int num1, num2, resto;
    
    // Solicita a entrada dos dois números inteiros
    printf("Digite o primeiro número (dividendo): ");
    scanf("%d", &num1);
    
    printf("Digite o segundo número (divisor): ");
    scanf("%d", &num2);
    
    // Verifica se o divisor é zero para evitar erros
    if (num2 == 0) {
        printf("Erro: Divisão por zero não é permitida.\n");
    } else {
        // Calcula o resto da divisão usando o operador % (módulo)
        resto = num1 % num2;
        
        // Exibe o resultado
        printf("O resto da divisão de %d por %d é: %d\n", num1, num2, resto);
    }
    
    return 0;
}
