#include <stdio.h>
#include <string.h>

int main() {
    char nome[100];
    float horas_trabalhadas;
    int num_dependentes;
    
    // Constantes do problema
    const float VALOR_HORA = 3.00;
    const float VALOR_DEPENDENTE = 100.00;
    const float PERCENTUAL_DESCONTO = 0.135; // 13.5%

    float salario_trabalho, bonus_dependentes, desconto, salario_liquido;

    // Entrada de dados
    printf("Digite o nome do funcionário: ");
    fgets(nome, sizeof(nome), stdin);
    nome[strcspn(nome, "\n")] = 0; // Remove a quebra de linha

    printf("Digite o número de horas trabalhadas: ");
    scanf("%f", &horas_trabalhadas);

    printf("Digite o número de dependentes: ");
    scanf("%d", &num_dependentes);

    // Cálculos conforme o enunciado
    // 1. Salário pelo trabalho (horas * R$ 3,00)
    salario_trabalho = horas_trabalhadas * VALOR_HORA;
    
    // 2. Bônus por dependentes (num * R$ 100,00)
    bonus_dependentes = num_dependentes * VALOR_DEPENDENTE;
    
    // 3. Desconto de 13,5% sobre o salário/trabalho
    desconto = salario_trabalho * PERCENTUAL_DESCONTO;
    
    // 4. Salário Líquido = (Salário Trabalho - Desconto) + Bônus Dependentes
    salario_liquido = (salario_trabalho - desconto) + bonus_dependentes;

    // Saída de resultados
    printf("\n--- Resultado do Cálculo ---\n");
    printf("Funcionário: %s\n", nome);
    printf("Salário Líquido: R$ %.2f\n", salario_liquido);

    return 0;
}
