#include <stdio.h>

int main() {
    float nota;
    float soma = 0.0;
    float media;

    printf("Calculadora de Média Aritmética de 5 Notas\n");

    for (int i = 1; i <= 5; i++) {
        printf("Digite a nota %d: ", i);
        
        // Lê a nota e valida se a entrada é um número
        if (scanf("%f", &nota) != 1) {
            printf("Entrada inválida. Por favor, digite um número válido.\n");
            // Limpa o buffer de entrada
            while (getchar() != '\n');
            i--; // Tenta ler novamente a mesma nota
            continue;
        }
        
        // Acumula o valor na variável soma
        soma += nota;
    }

    // Calcula a média aritmética dividindo a soma total por 5
    media = soma / 5.0;

    // Exibe o resultado final com duas casas decimais
    printf("\nA soma total das notas é: %.2f\n", soma);
    printf("A média aritmética das 5 notas é: %.2f\n", media);

    return 0;
}
