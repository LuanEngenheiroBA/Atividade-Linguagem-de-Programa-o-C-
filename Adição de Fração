#include <stdio.h>

int main() {
    double S = 0.0;
    int numerador = 50;
    int denominador = 1;

    printf("Calculando o somatório S = 50/1 + 49/2 + 48/3 + ... + 1/50\n\n");

    // O laço executa 50 vezes, uma para cada termo da soma
    for (int i = 1; i <= 50; i++) {
        // (double) é necessário para garantir que a divisão não seja inteira
        S += (double)numerador / denominador;
        
        // Atualiza os valores para o próximo termo
        numerador--;
        denominador++;
    }

    printf("O valor final de S é: %.4f\n", S);

    return 0;
}
