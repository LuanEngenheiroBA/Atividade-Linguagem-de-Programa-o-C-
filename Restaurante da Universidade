#include <stdio.h>

int main() {
    int vezes;
    int total_alunos = 0;
    int menos_10 = 0;
    int entre_10_15 = 0;
    int mais_15 = 0;

    printf("Insira a quantidade de vezes que o aluno usou o restaurante.\n");
    printf("Digite um numero negativo para encerrar e ver os resultados.\n\n");

    while (1) {
        printf("Quantidade de vezes do aluno %d: ", total_alunos + 1);
        scanf("%d", &vezes);

        // Condição de parada: se for negativo, sai do loop
        if (vezes < 0) {
            break;
        }

        // Incrementa o total de alunos válidos
        total_alunos++;

        // Classificação das faixas de uso
        if (vezes < 10) {
            menos_10++;
        } else if (vezes <= 15) { // Entre 10 e 15 (inclusive)
            entre_10_15++;
        } else { // Acima de 15
            mais_15++;
        }
    }

    // Exibição dos resultados (apenas se houver pelo menos 1 aluno)
    if (total_alunos > 0) {
        // Cálculo das porcentagens com conversão (cast) para float
        float perc_menos_10 = ((float)menos_10 / total_alunos) * 100;
        float perc_entre_10_15 = ((float)entre_10_15 / total_alunos) * 100;
        float perc_mais_15 = ((float)mais_15 / total_alunos) * 100;

        printf("\n-----------------------------------------\n");
        printf("           ESTATISTICAS DO MES           \n");
        printf("-----------------------------------------\n");
        printf("d) Numero de alunos entrevistados: %d\n", total_alunos);
        printf("a) Percentual que utilizou menos de 10 vezes: %.2f%%\n", perc_menos_10);
        printf("b) Percentual que utilizou entre 10 e 15 vezes: %.2f%%\n", perc_entre_10_15);
        printf("c) Percentual que utilizou acima de 15 vezes: %.2f%%\n", perc_mais_15);
        printf("-----------------------------------------\n");
    } else {
        printf("\nNenhum dado valido foi inserido.\n");
    }

    return 0;
}
