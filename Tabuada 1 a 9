#include <stdio.h>

int main() {
    int numero;

    printf("Digite um numero entre 0 e 9: ");
    scanf("%d", &numero);

    while (numero < 0 || numero > 9) {
        printf("Numero invalido! Digite um numero entre 0 e 9: ");
        scanf("%d", &numero);
    }

    printf("\n===== TABUADA DO %d =====\n", numero);

    for (int i = 1; i <= 10; i++) {
        printf("  %d x %2d = %3d\n", numero, i, numero * i);
    }

    printf("=========================\n");

    return 0;
}
