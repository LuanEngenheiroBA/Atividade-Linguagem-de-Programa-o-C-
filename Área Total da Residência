#include <stdio.h>

int main() {
    float largura, comprimento, area_comodo, area_total = 0;
    int continuar;

    printf("--- Calculadora de Área Residencial ---\n");

    do {
        printf("\nDigite a largura do cômodo (m): ");
        scanf("%f", &largura);
        
        printf("Digite o comprimento do cômodo (m): ");
        scanf("%f", &comprimento);

        area_comodo = largura * comprimento;
        area_total += area_comodo;

        printf("Área deste cômodo: %.2f m²\n", area_comodo);

        printf("\nDeseja adicionar outro cômodo? (1-Sim / 0-Não): ");
        scanf("%d", &continuar);

    } while (continuar == 1);

    printf("\n---------------------------------------\n");
    printf("Área total da residência: %.2f m²\n", area_total);
    printf("---------------------------------------\n");

    return 0;
}
