#include <stdio.h>

int main() {
    float num1, num2, resultado;
    
    // Solicita a entrada dos dois números
    printf("Digite o primeiro número: ");
    scanf("%f", &num1);
    
    printf("Digite o segundo número: ");
    scanf("%f", &num2);
    
    // Realiza o cálculo da multiplicação
    resultado = num1 * num2;
    
    // Exibe o resultado com duas casas decimais
    printf("A multiplicação de %.2f por %.2f é: %.2f\n", num1, num2, resultado);
    
    return 0;
}
