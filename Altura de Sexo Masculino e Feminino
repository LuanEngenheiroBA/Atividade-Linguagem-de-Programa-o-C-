#include <stdio.h>

int main() {
    float altura, maior_altura = 0, menor_altura = 0, soma_altura_mulheres = 0;
    int sexo, total_homens = 0, total_mulheres = 0, mulheres_abaixo_168 = 0, total_pessoas = 0;

    printf("Digite a altura e o sexo (1-Masculino, 2-Feminino).\n");
    printf("Para encerrar, digite uma altura menor ou igual a 0.\n\n");

    while (1) {
        printf("Altura: ");
        if (scanf("%f", &altura) != 1) {
            printf("Entrada inválida!\n");
            while(getchar() != '\n'); // Limpa o buffer
            continue;
        }

        // Condição de parada: altura menor ou igual a zero
        if (altura <= 0) break;

        printf("Sexo (1-M, 2-F): ");
        if (scanf("%d", &sexo) != 1 || (sexo != 1 && sexo != 2)) {
            printf("Sexo inválido! Tente novamente.\n");
            while(getchar() != '\n');
            continue;
        }

        // a) Cálculo da maior e menor altura do grupo
        if (total_pessoas == 0) {
            maior_altura = altura;
            menor_altura = altura;
        } else {
            if (altura > maior_altura) maior_altura = altura;
            if (altura < menor_altura) menor_altura = altura;
        }

        // b) Contagem de homens e processamento de dados das mulheres
        if (sexo == 1) {
            total_homens++;
        } else if (sexo == 2) {
            total_mulheres++;
            soma_altura_mulheres += altura;
            
            // d) Contagem para o percentual de mulheres abaixo de 1,68m
            if (altura < 1.68) {
                mulheres_abaixo_168++;
            }
        }

        total_pessoas++;
    }

    // Exibição dos resultados finais
    if (total_pessoas > 0) {
        printf("\n--- RESULTADOS ---\n");
        printf("a) Maior altura: %.2f m | Menor altura: %.2f m\n", maior_altura, menor_altura);
        printf("b) Número de homens: %d\n", total_homens);

        if (total_mulheres > 0) {
            // c) Cálculo da média de altura das mulheres
            printf("c) Média de altura das mulheres: %.2f m\n", soma_altura_mulheres / total_mulheres);
            
            // d) Cálculo do percentual de mulheres abaixo de 1,68m
            float percentual = (float)mulheres_abaixo_168 / total_mulheres * 100;
            printf("d) Percentual de mulheres abaixo de 1,68m: %.2f%%\n", percentual);
        } else {
            printf("c) Nenhuma mulher informada para calcular a média.\n");
            printf("d) Nenhuma mulher informada para calcular o percentual.\n");
        }
    } else {
        printf("\nNenhum dado válido foi inserido.\n");
    }

    return 0;
}
