using System;

public class Program
{
    public static void Main()
    {
        Console.Write("Digite um número: ");
        int numero = Convert.ToInt32(Console.ReadLine());
        
        Console.WriteLine("\nOs 5 sucessores de " + numero + " são:");
        
        for(int i = 1; i <= 5; i++)
        {
            Console.WriteLine(numero + i);
        }
    }
}
