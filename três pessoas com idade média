#include <stdio.h>

int main() {
    int idade;
    int soma_idades = 0;
    float media_idades;

    printf("Calculadora de Média de Idade para Três Indivíduos\n");

    for (int i = 1; i <= 3; i++) {
        printf("Digite a idade do indivíduo %d: ", i);
        
        // Lê a idade e valida se a entrada é um número inteiro
        if (scanf("%d", &idade) != 1) {
            printf("Entrada inválida. Por favor, digite um número inteiro.\n");
            // Limpa o buffer de entrada
            while (getchar() != '\n');
            i--; // Tenta ler novamente para o mesmo indivíduo
            continue;
        }
        
        // Acumula a idade na variável soma_idades
        soma_idades += idade;
    }

    // Calcula a média convertendo a soma para float para garantir precisão
    media_idades = (float)soma_idades / 3.0;

    // Exibe os resultados
    printf("\nA soma das idades é: %d\n", soma_idades);
    printf("A média de idade dos três indivíduos é: %.2f\n", media_idades);

    return 0;
}
